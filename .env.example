# Neon Postgres connection string (pooled connection recommended)
# Neon dashboard → your project → Connect → copy the "pooled connection" string
DATABASE_URL=postgresql://user:password@ep-example-12345.eu-west-1.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign auth sessions/cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The deployed URL of this app (used by Better Auth for callback/cookie config).
# Locally this is usually http://localhost:3000 — check your `vite dev` output for the actual port.
BETTER_AUTH_URL=http://localhost:3000
